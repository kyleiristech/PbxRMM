{
  "name": "pbx-rmm",
  "version": "0.1.0",
  "description": "Remote management and monitoring service for 3CX phone systems",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ui": "npm run dev --prefix frontend",
    "build": "tsc --pretty false",
    "build:ui": "npm run build --prefix frontend",
    "build:all": "npm run build && npm run build:ui",
    "preview:ui": "npm run preview --prefix frontend",
    "start": "node dist/index.js",
    "test": "echo \"No automated tests yet\" && exit 0"
  },
  "keywords": [
    "3cx",
    "monitoring",
    "pbx",
    "remote-management"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyleiristech/PbxRMM.git"
  },
  "bugs": {
    "url": "https://github.com/kyleiristech/PbxRMM/issues"
  },
  "homepage": "https://github.com/kyleiristech/PbxRMM#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pino": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
